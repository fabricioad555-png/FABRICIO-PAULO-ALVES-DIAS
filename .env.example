# Bybit API Configuration
# Active environment: testnet or live
BYBIT_ACTIVE_ENV=testnet

# Security: Enable live orders?
ENABLE_LIVE_ORDERS=false
# Confirmation string required if ENABLE_LIVE_ORDERS is true: I_UNDERSTAND_LIVE_TRADING
ENABLE_LIVE_ORDERS_CONFIRMATION=

# Testnet Credentials
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_TESTNET_REST_URL=https://api-testnet.bybit.com
BYBIT_TESTNET_WS_PRIVATE_URL=wss://stream-testnet.bybit.com/v5/private

# Live Credentials
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_API_SECRET=
BYBIT_LIVE_REST_URL=https://api.bybit.com
BYBIT_LIVE_WS_PRIVATE_URL=wss://stream.bybit.com/v5/private

# Safety Settings
MAX_ORDER_NOTIONAL_USDT=1000
MAX_OPEN_ORDERS=50
BYBIT_RECV_WINDOW=5000
